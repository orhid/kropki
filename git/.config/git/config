[include]
	path = alias
	path = dupc

# settings

[core]
	# treat spaces before tabs and all kinds of trailing whitespace as an error
	# [default] trailing-space: looks for spaces at the end of a line
	# [default] space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab,indent-with-non-tab,-tab-with-indent,trailing-space

[push]
	default = upstream

[apply]
	# detect whitespace errors when applying a patch
	whitespace = warn

[help]
	# wait 0.1 seconds before applying a correction
	autocorrect = 1


# config

[init]
	defaultBranch = trunk
[commit]
	gpgsign = false


