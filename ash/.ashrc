# # proompt

proompt_pwd() {
	local p rel last second

	p=$(pwd)

	case "$p" in
		/)
			printf "/"
			return
			;;
	esac

	rel=${p#/}

	case "$rel" in
		*/*/*)
			last=${rel##*/}
			second=${rel%/*}
			second=${second##*/}
			printf "../%s/%s" "$second" "$last"
			;;
		*)
			printf "%s" "$p"
			;;
	esac
}

proompt_user_mark() {
	case "$(whoami)" in
		root)
			printf "#"
			;;
		orhid)
			printf "ø"
			;;
		hvalur)
			printf "η"
			;;
	esac
}

git_proompt() {
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

	local branch marks ahead behind

	branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null ||
			 git rev-parse --short HEAD)

	# Merge conflicts
	git diff --quiet --diff-filter=U || marks="${marks}!"

	# Staged changes
	git diff --cached --quiet || marks="${marks}S"

	# Unstaged changes
	git diff --quiet || marks="${marks}M"

	# Untracked files
	[ -z "$(git ls-files --others --exclude-standard)" ] || marks="${marks}U"

	# Ahead/behind of upstream
	if git rev-parse @{upstream} >/dev/null 2>&1; then
		set -- $(git rev-list --left-right --count HEAD...@{upstream})
		ahead=$1
		behind=$2

		[ "$ahead" -gt 0 ] && marks="${marks}↑"
		[ "$behind" -gt 0 ] && marks="${marks}↓"
	fi

	printf ' \033[37m['

	if [ -n "$marks" ]; then
		printf '\033[35m%s \033[36m%s' "$marks" "$branch"
	else
		printf '\033[36m%s' "$branch"
	fi

	printf '\033[37m]\033[0m'
}

PSHOST="\[\033[0;36m\]\h\[\033[0m\]"
# -- the '' are important
PS1='$PSHOST:\[\033[0;34m\]$(proompt_pwd)$(git_proompt)\[\033[1;33m\] $(proompt_user_mark) \[\033[0m\]'

# # exports
export HELIX_RUNTIME=/vault/helix/runtime


# # aliases
# ## safe·operations
alias cp="cp -ivp"
alias mv="mv -iv"
alias rm="rm -i"
alias mkdir="mkdir -vp"


# ## eza or ls
if command -v eza >/dev/null 2>&1; then
	alias ls="eza -AF --color=always \
		--follow-symlinks \
		--group-directories-first"
	alias la="eza -lbAF --color=always --git \
		--follow-symlinks \
		--group-directories-first \
		--time-style=+%b%d:%I:%M%p"
	alias ll="la --git-ignore"
	alias lta="la -T -L3"
	alias lt="lta --git-ignore"
else
	alias ls="ls -AF --color=always \
		--group-directories-first"
	alias ll="ls -lhAF -lu --color=always \
		--group-directories-first"
fi

# ## bat or cat
if command -v bat >/dev/null 2>&1; then
	alias cat="bat --plain --pager=never"
fi
