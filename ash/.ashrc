# # proompt
PSHOST="\[\033[0m\][\[\033[0;96m\]ash\[\033[0m\]|\[\033[1;36m\]\h\[\033[0m\]]"
PS1="$PSHOST:\[\033[0;34m\]\W \[\033[1;33m\]ø \[\033[0m\]"


# # exports
export HELIX_RUNTIME=/vault/helix/runtime


# # stow kropki
if command -v stow >/dev/null 2>&1; then
	(cd /etc/kropki && stow */ --target=$HOME)
fi


# # load ssh keys
# -- these should be in and and statement
if command -v ssh-tpm-agent >/dev/null 2>&1; then
	if [ -d $HOME/.ssh ]; then
		ssh-tpm-add $HOME/.ssh/*.tpm >/dev/null
	fi
fi


# # aliases
# ## safe·operations
alias cp="cp -ivp"
alias mv="mv -iv"
alias rm="rm -i"
alias mkdir="mkdir -vp"


# ## eza or ls
if command -v eza >/dev/null 2>&1; then
	alias ls="eza -AF --color=always \
		--follow-symlinks \
		--group-directories-first"
	alias la="eza -lbAF --color=always --git \
		--follow-symlinks \
		--group-directories-first \
		--time-style=+%b%d:%I:%M%p"
	alias ll="la --git-ignore"
	alias lta="la -T -L3"
	alias lt="lta --git-ignore"
else
	alias ls="ls -AF --color=always \
		--group-directories-first"
	alias ll="ls -lhAF -lu --color=always \
		--group-directories-first"
fi

# ## bat or cat
if command -v bat >/dev/null 2>&1; then
	alias cat="bat --plain --pager=never"
fi
