layout {
	default_tab_template {
		pane size=2 borderless=true {
			plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
				format_left "{session} {tabs}"
				format_center "{mode}"
				format_right "{command_battery} | {datetime}"

				// hide_frame_for_single_pane "true"

				// border_enabled "true"
				// border_char "-"
				// border_position "bottom"

				datetime "#[fg=yellow]{format}"
				datetime_format "%-I:%M %p"
				datetime_timezone "Europe/Warsaw"

				tab_separator " "
				tab_normal "#[fg=black,bg=yellow] {name} "
				tab_active "#[fg=black,bg=magenta] {name} "

				mode_normal "NORMAL"
				mode_locked "LOCKED"

				command_battery_command "ash -c \"cat /sys/class/power_supply/BAT1/capacity\""
				command_battery_format "{stdout}%"
				command_battery_interval "72"
				command_battery_rendermode "static"
			}
		}
		children
	}
}
