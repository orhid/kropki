layout {
	default_tab_template {
		pane size=1 borderless=true {
			plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
				format_left " {mode} {tabs}"
				format_center "{session}"
				format_right "{command_battery} | {datetime} "

				tab_separator " "
				tab_normal "#[fg=black,bg=blue] {name} "
				tab_active "#[fg=black,bg=white] {name} "

				datetime "{format}"
				datetime_format "%-I:%M %p"
				datetime_timezone "Europe/Warsaw"

				command_battery_command "ash -c \".config/zellij/scripts/battery\""
				command_battery_format "{stdout}"
				command_battery_interval "72"
				command_battery_rendermode "static"

				mode_normal "#[fg=black,bg=white] NOR "
				mode_locked "#[fg=black,bg=yellow] LCK "

				// -- it would be good to place shortcuts for some modes here
				mode_tmux "#[fg=black,bg=blue] {name} "
				mode_default_to_mode "tmux"
			}
		}
		children
	}
}
