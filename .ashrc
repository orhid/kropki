# # proompt
PSHOST="\[\033[0m\][\[\033[0;96m\]ash\[\033[0m\]|\[\033[1;36m\]\h\[\033[0m\]]"
PS1="$PSHOST:\[\033[0;34m\]\W \[\033[1;33m\]ø \[\033[0m\]"


# # exports
export HELIX_RUNTIME=/vault/helix/runtime


# # aliases
# ## safe·operations
alias cp="cp -ivp"
alias mv="mv -iv"
alias rm="rm -i"
alias mkdir="mkdir -vp"

# ## eza or ls
if command -v eza >/dev/null 2>&1; then
	alias ls="eza -AF --color=always \
		--group-directories-first"
	alias ll="eza -lbAF --color=always --git \
		--group-directories-first \
		--time-style=+%b%d:%I:%M%p"
	alias lt="eza -lbAF -T -L2 --color=always --git \
		--group-directories-first \
		--time-style=+%b%d:%I:%M%p"
else
	alias ls="ls -AF --color=always \
		--group-directories-first"
	alias ll="ls -lhAF -lu --color=always \
		--group-directories-first"
fi

# ## bat or cat
if command -v bat >/dev/null 2>&1; then
	alias cat="bat --pager=never"
fi
